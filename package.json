{
  "name": "winter-fayre",
  "version": "1.0.0",
  "private": true,
  "description": "The Winter Fayre Sports Arcade: quick sports games to play on a phone, with the day's leaderboards.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "dev": "vite build && node --watch-path=server server/index.js",
    "test": "node --test \"tests/**/*.test.js\" && vitest run",
    "test:server": "node --test \"tests/**/*.test.js\"",
    "test:client": "vitest run",
    "check": "vite build && node tools/check.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "three": "0.186.1",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "vitest": "^3.2.4"
  }
}
