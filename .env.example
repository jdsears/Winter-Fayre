# The site's settings. Names only: set the values in Railway (or in a
# local .env that is never committed).

# Railway sets this.
PORT=

# The site's full address, used to draw the QR code on the TV page, for
# example https://your-service.up.railway.app with no slash at the end.
# Left empty on Railway, the address Railway gave the service is used.
SITE_ORIGIN=

# production on Railway: HTTPS only, and the stricter headers.
NODE_ENV=

# The password for /numbers, the site's own page views and game plays.
# Without it the page is not there. Pick a long one.
NUMBERS_PASSWORD=

# A folder to keep the day's leaderboards and numbers in, so a restart
# does not wipe the day. Left empty on Railway, an attached volume is
# found by itself. With neither, they are kept in memory only.
DATA_DIR=
